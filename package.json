{
  "name": "smart-parcel-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Smart Parcel Atlas — one building record, read by each institution through its own lens. Built on the SPARC enriched building layer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:search": "esbuild tools/check-search.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/check-search.cjs --log-level=error && node node_modules/.cache/check-search.cjs",
    "data": "python tools/prepare_data.py",
    "check:data": "node tools/check-dataset.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "esbuild": "^0.21.5"
  }
}
